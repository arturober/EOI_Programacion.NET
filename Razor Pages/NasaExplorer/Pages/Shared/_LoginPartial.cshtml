@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

@* El menú cambia según exista o no una sesión de Identity. *@
@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <button class="btn btn-outline-light btn-sm dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-page="/Favoritos/Index">
                    <i class="bi bi-star-fill text-warning me-2"></i>Mis favoritos
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form method="post" asp-page="/Cuenta/Salir">
                    <button class="dropdown-item" type="submit">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="btn btn-outline-light btn-sm" asp-page="/Cuenta/Login">Entrar</a>
    <a class="btn btn-warning btn-sm" asp-page="/Cuenta/Registro">Registrarse</a>
}
