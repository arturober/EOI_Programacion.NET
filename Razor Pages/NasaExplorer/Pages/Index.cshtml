@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-nasa rounded-4 p-4 p-lg-5 d-flex align-items-center shadow-lg mb-5">
    <div class="col-lg-8">
        <span class="badge text-bg-info mb-3">Siete fuentes de datos oficiales</span>
        <h1 class="display-3 fw-bold text-white">Explora el universo con datos de NASA</h1>
        <p class="lead text-white-50">
            Fotografías astronómicas, la Tierra desde el espacio, asteroides,
            eventos naturales, meteorología espacial, exoplanetas y el archivo
            multimedia de NASA en una sola aplicación.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-warning btn-lg" asp-page="/Apod/Index">
                <i class="bi bi-stars me-2"></i>Ver la imagen del día
            </a>
            <a class="btn btn-outline-light btn-lg" asp-page="/Multimedia/Index">
                Buscar en el archivo
            </a>
        </div>
    </div>
</section>

@if (!Model.ClaveConfigurada)
{
    <div class="alert alert-warning shadow-sm">
        <h2 class="h5"><i class="bi bi-key-fill me-2"></i>Falta configurar la clave</h2>
        <p class="mb-2">
            APOD y asteroides necesitan tu clave. Los demás apartados ya pueden utilizarse.
        </p>
        <code>dotnet user-secrets set "Nasa:ApiKey" "TU_CLAVE"</code>
    </div>
}

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <p class="text-info text-uppercase fw-semibold mb-1">Exploradores</p>
            <h2 class="mb-0">Todo lo que incluye el proyecto</h2>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Apod/Index">
                <div class="card-body">
                    <i class="bi bi-stars fs-1 text-warning"></i>
                    <h3 class="h5 mt-3">APOD</h3>
                    <p class="text-body-secondary mb-0">La imagen astronómica del día y su explicación.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Multimedia/Index">
                <div class="card-body">
                    <i class="bi bi-images fs-1 text-info"></i>
                    <h3 class="h5 mt-3">Multimedia</h3>
                    <p class="text-body-secondary mb-0">Imágenes, vídeos y audios del archivo oficial.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Tierra/Epic">
                <div class="card-body">
                    <i class="bi bi-globe-americas fs-1 text-success"></i>
                    <h3 class="h5 mt-3">La Tierra con EPIC</h3>
                    <p class="text-body-secondary mb-0">El planeta completo desde el satélite DSCOVR.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Tierra/Eventos">
                <div class="card-body">
                    <i class="bi bi-map fs-1 text-danger"></i>
                    <h3 class="h5 mt-3">Eventos EONET</h3>
                    <p class="text-body-secondary mb-0">Incendios, volcanes y tormentas sobre un mapa.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Asteroides/Index">
                <div class="card-body">
                    <i class="bi bi-circle-fill fs-1 text-secondary"></i>
                    <h3 class="h5 mt-3">Asteroides cercanos</h3>
                    <p class="text-body-secondary mb-0">Tamaño, velocidad, distancia y riesgo estimado.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/ClimaEspacial/Index">
                <div class="card-body">
                    <i class="bi bi-sun-fill fs-1 text-warning"></i>
                    <h3 class="h5 mt-3">Clima espacial</h3>
                    <p class="text-body-secondary mb-0">Llamaradas, tormentas y eyecciones del sistema DONKI.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Exoplanetas/Index">
                <div class="card-body">
                    <i class="bi bi-record-circle fs-1 text-primary"></i>
                    <h3 class="h5 mt-3">Exoplanetas</h3>
                    <p class="text-body-secondary mb-0">Mundos confirmados fuera del sistema solar.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a class="card tarjeta-elevada h-100 text-decoration-none" asp-page="/Favoritos/Index">
                <div class="card-body">
                    <i class="bi bi-star-fill fs-1 text-warning"></i>
                    <h3 class="h5 mt-3">Favoritos privados</h3>
                    <p class="text-body-secondary mb-0">Cada usuario conserva su propia colección en SQLite.</p>
                </div>
            </a>
        </div>
    </div>
</section>

@if (Model.Apod is not null)
{
    <section class="card overflow-hidden shadow mb-5">
        <div class="row g-0">
            <div class="col-lg-7 bg-black">
                @if (Model.Apod.TipoMedio == "image")
                {
                    <img class="imagen-apod"
                         src="@Model.Apod.Url"
                         alt="@Model.Apod.Titulo" />
                }
                else
                {
                    <div class="ratio ratio-16x9">
                        <iframe src="@Model.Apod.Url"
                                title="@Model.Apod.Titulo"
                                allowfullscreen></iframe>
                    </div>
                }
            </div>
            <div class="col-lg-5">
                <div class="card-body p-lg-4">
                    <span class="badge text-bg-primary">APOD de hoy</span>
                    <h2 class="mt-3">@Model.Apod.Titulo</h2>
                    <p class="descripcion-limitada">@Model.Apod.Explicacion</p>
                    <a class="btn btn-outline-info"
                       asp-page="/Apod/Index"
                       asp-route-fecha="@Model.Apod.Fecha">Leer la explicación completa</a>
                </div>
            </div>
        </div>
    </section>
}
else if (Model.ErrorApod is not null)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@Model.ErrorApod
    </div>
}
