@page
@model NasaExplorer.Pages.Cuenta.RegistroModel
@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center py-lg-5">
    <div class="col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill display-3 text-warning"></i>
                    <h1 class="h3 mt-2">Crear una cuenta</h1>
                    <p class="text-body-secondary">
                        El correo no requiere confirmación en este proyecto.
                    </p>
                </div>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Entrada.Email"
                               class="form-control"
                               autocomplete="email"
                               placeholder="nombre@correo.es" />
                        <label asp-for="Entrada.Email">Correo electrónico</label>
                        <span asp-validation-for="Entrada.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Entrada.Contrasena"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Contraseña" />
                        <label asp-for="Entrada.Contrasena">Contraseña</label>
                        <span asp-validation-for="Entrada.Contrasena" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Entrada.ConfirmarContrasena"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Repite la contraseña" />
                        <label asp-for="Entrada.ConfirmarContrasena">Repite la contraseña</label>
                        <span asp-validation-for="Entrada.ConfirmarContrasena" class="text-danger"></span>
                    </div>
                    <button class="btn btn-warning w-100" type="submit">Crear cuenta</button>
                </form>
                <p class="small text-body-secondary mt-3 mb-0">
                    La contraseña debe tener al menos seis caracteres, una letra
                    minúscula y un número.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
