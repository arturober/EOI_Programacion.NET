@{
    // Estas variables permiten destacar la sección que se está visitando.
    string paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool estaEnInicio = paginaActual == "/Index";
    bool estaEnListado =
        paginaActual == "/Listado" || paginaActual == "/Detalle";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="Proyecto educativo Razor Pages que consulta PokeAPI." />

    <title>@ViewData["Title"] - Pokédex</title>

    @* Esta hoja se sustituye por el tema elegido por el usuario. *@
    <link id="temaCss"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />
</head>
<body class="bg-body-tertiary min-vh-100 d-flex flex-column">
    @* La barra queda visible al desplazarnos y se adapta a pantallas pequeñas. *@
    <nav class="navbar navbar-expand-lg bg-primary sticky-top shadow-sm"
         data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-circle-half me-2"></i>Pokédex
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Mostrar u ocultar el menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(estaEnInicio ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Index"
                           aria-current="@(estaEnInicio ? "page" : null)">
                            <i class="bi bi-house me-1"></i>Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(estaEnListado ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Listado"
                           aria-current="@(estaEnListado ? "page" : null)">
                            <i class="bi bi-grid-3x3-gap me-1"></i>Listado
                        </a>
                    </li>
                </ul>

                @* El desplegable incluye Bootstrap y todos los temas de Bootswatch. *@
                <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
                    <label for="selectorTema"
                           class="text-white fs-5"
                           title="Seleccionar el tema">
                        <i class="bi bi-palette" aria-hidden="true"></i>
                        <span class="visually-hidden">Tema</span>
                    </label>
                    <select id="selectorTema"
                            class="form-select form-select-sm"
                            aria-label="Seleccionar el tema"
                            onchange="cambiarTema(this.value)">
                        <optgroup label="Bootstrap">
                            <option value="bootstrap-light" selected>
                                Bootstrap claro
                            </option>
                            <option value="bootstrap-dark">Bootstrap oscuro</option>
                        </optgroup>
                        <optgroup label="Bootswatch">
                            <option value="bootswatch-brite">Brite</option>
                            <option value="bootswatch-cerulean">Cerulean</option>
                            <option value="bootswatch-cosmo">Cosmo</option>
                            <option value="bootswatch-cyborg">Cyborg</option>
                            <option value="bootswatch-darkly">Darkly</option>
                            <option value="bootswatch-flatly">Flatly</option>
                            <option value="bootswatch-journal">Journal</option>
                            <option value="bootswatch-litera">Litera</option>
                            <option value="bootswatch-lumen">Lumen</option>
                            <option value="bootswatch-lux">Lux</option>
                            <option value="bootswatch-materia">Materia</option>
                            <option value="bootswatch-minty">Minty</option>
                            <option value="bootswatch-morph">Morph</option>
                            <option value="bootswatch-pulse">Pulse</option>
                            <option value="bootswatch-quartz">Quartz</option>
                            <option value="bootswatch-sandstone">Sandstone</option>
                            <option value="bootswatch-simplex">Simplex</option>
                            <option value="bootswatch-sketchy">Sketchy</option>
                            <option value="bootswatch-slate">Slate</option>
                            <option value="bootswatch-solar">Solar</option>
                            <option value="bootswatch-spacelab">Spacelab</option>
                            <option value="bootswatch-superhero">Superhero</option>
                            <option value="bootswatch-united">United</option>
                            <option value="bootswatch-vapor">Vapor</option>
                            <option value="bootswatch-yeti">Yeti</option>
                            <option value="bootswatch-zephyr">Zephyr</option>
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
    </nav>

    @* Cada página introduce aquí su contenido concreto. *@
    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-4 mt-4">
        <div class="container text-center text-body-secondary small">
            Proyecto educativo desarrollado con Razor Pages, Bootstrap y
            <a href="https://pokeapi.co/"
               target="_blank"
               rel="noopener">PokeAPI</a>.
        </div>
    </footer>

    @* El bundle incluye los componentes JavaScript de Bootstrap, como el carrusel. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/temas.js" asp-append-version="true"></script>

    @* Una página concreta puede añadir sus propios scripts en esta sección. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
