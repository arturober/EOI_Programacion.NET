@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

@* Mensaje genérico para no revelar información técnica al usuario. *@
<div class="text-center bg-body border rounded-3 p-5">
    <i class="bi bi-exclamation-triangle display-4 text-danger"></i>
    <h1 class="h2 mt-3">Se ha producido un error</h1>
    <p class="text-secondary">
        No ha sido posible completar la operación.
    </p>

    @if (Model.MostrarIdPeticion)
    {
        <p class="small">
            Identificador: <code>@Model.IdPeticion</code>
        </p>
    }

    <a asp-page="/Index" class="btn btn-danger">
        Volver al listado
    </a>
</div>
