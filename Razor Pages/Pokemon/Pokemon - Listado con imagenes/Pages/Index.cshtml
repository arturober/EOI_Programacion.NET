@page
@model IndexModel
@{
    ViewData["Title"] = "Listado con imágenes";
}

<header class="mb-4">
    <h1 class="display-5 fw-bold">Pokédex</h1>
    <p class="lead mb-0">
        Los 151 Pokémon de la primera generación, ahora con su imagen.
    </p>
</header>

<div class="row g-3">
    @foreach (PokemonListaApi pokemon in Model.Pokemons)
    {
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <article class="card h-100 text-center shadow-sm">
                <img src="@pokemon.ImagenUrl"
                     class="card-img-top object-fit-contain p-2"
                     alt="@pokemon.Nombre"
                     width="160"
                     height="160"
                     loading="lazy" />
                <div class="card-body pt-0">
                    <p class="text-secondary small mb-1">N.º @pokemon.Id</p>
                    <h2 class="h6 text-capitalize mb-0">@pokemon.Nombre</h2>
                </div>
            </article>
        </div>
    }
</div>
