@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="p-4 p-md-5 mb-5 bg-body-tertiary rounded-3 shadow-sm">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-4 fw-bold">
                <i class="bi bi-camera-reels-fill text-primary"></i>
                Descubre tu próxima película
            </h1>
            <p class="lead">
                Explora el catálogo de TMDB y crea una colección personal
                de favoritas guardada en SQLite.
            </p>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary btn-lg"
                       asp-page="/Cuenta/Registro">
                        <i class="bi bi-person-plus me-1"></i>Crear una cuenta
                    </a>
                    <a class="btn btn-outline-secondary btn-lg"
                       asp-page="/Cuenta/Login">
                        Iniciar sesión
                    </a>
                </div>
            }
            else
            {
                <a class="btn btn-danger btn-lg"
                   asp-page="/Favoritos/Index">
                    <i class="bi bi-heart-fill me-1"></i>Ver mis favoritas
                </a>
            }
        </div>

        <div class="col-lg-5">
            <form method="get"
                  asp-page="/Peliculas/Buscar"
                  class="card card-body shadow-sm"
                  role="search">
                <label for="busquedaPrincipal"
                       class="form-label fw-semibold">
                    Buscar en TMDB
                </label>
                <div class="input-group input-group-lg">
                    <input id="busquedaPrincipal"
                           name="texto"
                           class="form-control"
                           placeholder="Ejemplo: El padrino"
                           minlength="2"
                           maxlength="100"
                           required />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i>
                        <span class="visually-hidden">Buscar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@if (!Model.EstaConfigurado)
{
    <div class="alert alert-warning shadow-sm" role="alert">
        <h2 class="h4 alert-heading">
            <i class="bi bi-key-fill me-1"></i>Falta el token de TMDB
        </h2>
        <p>
            Abre una terminal en la carpeta del proyecto y ejecuta:
        </p>
        <pre class="bg-dark text-light rounded p-3 mb-3"><code>dotnet user-secrets set "Tmdb:TokenAcceso" "TU_TOKEN"</code></pre>
        <p class="mb-0">
            Debes utilizar el valor denominado <strong>API Read Access Token</strong>.
            El proceso completo se explica en <code>README.md</code>.
        </p>
    </div>
}

@if (Model.EstaConfigurado)
{
    var peliculasCarrusel = Model.Tendencias.Resultados
        .Where(pelicula => pelicula.UrlFondo is not null)
        .Take(5)
        .ToList();

    @if (peliculasCarrusel.Count > 0)
    {
        <section class="mb-5">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h3 mb-0">Tendencias de la semana</h2>
                <a class="btn btn-outline-primary btn-sm"
                   asp-page="/Peliculas/Index"
                   asp-route-tipo="@TipoListado.Tendencias.ParaUrl()">
                    Ver todas
                </a>
            </div>

            @* El carrusel reutiliza las tendencias que ya ha cargado la página. *@
            <div id="carruselTendencias"
                 class="carousel slide rounded-4 overflow-hidden shadow">
                <div class="carousel-indicators">
                    @for (int i = 0; i < peliculasCarrusel.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#carruselTendencias"
                                data-bs-slide-to="@i"
                                class="bg-white @(i == 0 ? "active" : "")"
                                aria-current="@(i == 0 ? "true" : null)"
                                aria-label="Mostrar película @(i + 1)">
                        </button>
                    }
                </div>

                <div class="carousel-inner">
                    @for (int i = 0; i < peliculasCarrusel.Count; i++)
                    {
                        PeliculaResumen pelicula = peliculasCarrusel[i];

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="ratio ratio-16x9 bg-dark">
                                <img src="@pelicula.UrlFondo"
                                     class="d-block w-100 object-fit-cover opacity-100"
                                     alt="Fondo de @pelicula.Titulo"
                                     loading="@(i == 0 ? "eager" : "lazy")" />
                            </div>

                            <div class="carousel-caption text-white bg-black bg-opacity-50 rounded p-2 p-md-3">
                                <h3 class="h4 fw-bold">@pelicula.Titulo</h3>
                                <p class="d-none d-md-block mb-2">
                                    @pelicula.Anio ·
                                    <i class="bi bi-star-fill text-warning"></i>
                                    @pelicula.Puntuacion.ToString("0.0")
                                </p>
                                <a class="btn btn-primary btn-sm"
                                   asp-page="/Peliculas/Detalles"
                                   asp-route-id="@pelicula.Id">
                                    Ver detalles
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev opacity-100"
                        type="button"
                        data-bs-target="#carruselTendencias"
                        data-bs-slide="prev">
                    <span class="d-inline-flex align-items-center justify-content-center
                                 bg-white text-dark border border-dark rounded-circle shadow p-2 lh-1">
                        <i class="bi bi-chevron-left fs-3"
                           aria-hidden="true"></i>
                    </span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next opacity-100"
                        type="button"
                        data-bs-target="#carruselTendencias"
                        data-bs-slide="next">
                    <span class="d-inline-flex align-items-center justify-content-center
                                 bg-white text-dark border border-dark rounded-circle shadow p-2 lh-1">
                        <i class="bi bi-chevron-right fs-3"
                           aria-hidden="true"></i>
                    </span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        </section>
    }

    @foreach (var seccion in new[]
    {
        new
        {
            Tipo = TipoListado.EnCartelera,
            Peliculas = Model.Cartelera.Resultados.Take(6)
        },
        new
        {
            Tipo = TipoListado.MejorValoradas,
            Peliculas = Model.MejorValoradas.Resultados.Take(6)
        }
    })
    {
        <section class="mb-5">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h3 mb-0">@seccion.Tipo.Titulo()</h2>
                <a class="btn btn-outline-primary btn-sm"
                   asp-page="/Peliculas/Index"
                   asp-route-tipo="@seccion.Tipo.ParaUrl()">
                    Ver todas
                </a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
                @foreach (PeliculaResumen pelicula in seccion.Peliculas)
                {
                    <div class="col">
                        <partial name="_TarjetaPelicula" model="pelicula" />
                    </div>
                }
            </div>
        </section>
    }
}
