@page
@model global::Biblioteca.Pages.Favoritos.IndexModel
@{
    ViewData["Title"] = "Mis favoritos";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <header>
        <h1><i class="bi bi-heart-fill text-danger me-2"></i>Mis favoritos</h1>
        <p class="text-body-secondary mb-0">
            Tu colección privada guardada en SQLite.
        </p>
    </header>

    @if (Model.Libros.Count > 1)
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label for="orden" class="form-label mb-0">Ordenar por</label>
            <select id="orden"
                    name="orden"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="recientes"
                        selected="@(Model.Orden == "recientes" ? "selected" : null)">
                    Más recientes
                </option>
                <option value="titulo"
                        selected="@(Model.Orden == "titulo" ? "selected" : null)">
                    Título
                </option>
                <option value="anio"
                        selected="@(Model.Orden == "anio" ? "selected" : null)">
                    Año
                </option>
                <option value="puntuacion"
                        selected="@(Model.Orden == "puntuacion" ? "selected" : null)">
                    Puntuación
                </option>
            </select>
        </form>
    }
</div>

@if (Model.Libros.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
        @foreach (LibroResumen libro in Model.Libros)
        {
            <div class="col">
                <partial name="_TarjetaLibro" model="libro" />
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 bg-body-tertiary">
        <div class="card-body text-center py-5">
            <i class="bi bi-heart display-1 text-body-secondary"></i>
            <h2 class="h4 mt-3">Todavía no has guardado ningún libro</h2>
            <p class="text-body-secondary">
                Pulsa el corazón de cualquier tarjeta para crear tu colección.
            </p>
            <a class="btn btn-primary"
               asp-page="/Libros/Index"
               asp-route-tipo="tendencias">
                Explorar libros
            </a>
        </div>
    </div>
}
