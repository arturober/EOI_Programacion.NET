@model LibroResumen
@{
    // Permite volver al mismo listado después de cambiar un favorito.
    string retorno =
        $"{ViewContext.HttpContext.Request.Path}"
        + $"{ViewContext.HttpContext.Request.QueryString}";
}

<article class="card h-100 shadow-sm">
    <div class="position-relative">
        <div class="ratio bg-body-tertiary"
             style="--bs-aspect-ratio: 150%;">
            @if (Model.UrlPortada is not null)
            {
                <img src="@Model.UrlPortada"
                     class="w-100 h-100 object-fit-contain"
                     alt="Portada de @Model.Titulo"
                     data-portada
                     loading="lazy" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary">
                    <i class="bi bi-book display-1"></i>
                    <span>Sin portada</span>
                </div>
            }
        </div>

        @if (Model.Puntuacion is not null)
        {
            <span class="badge text-bg-warning position-absolute bottom-0 start-0 m-2">
                <i class="bi bi-star-fill me-1"></i>
                @Model.Puntuacion.Value.ToString("0.0")
            </span>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post"
                  asp-page="/Favoritos/Alternar"
                  class="position-absolute top-0 end-0 m-2 z-3"
                  data-confirmar-favorito="@(Model.EsFavorito ? "true" : null)">
                <input type="hidden" name="libroId" value="@Model.Id" />
                <input type="hidden"
                       name="accion"
                       value="@(Model.EsFavorito ? "quitar" : "agregar")" />
                <input type="hidden" name="returnUrl" value="@retorno" />

                <button class="btn @(Model.EsFavorito ? "btn-danger" : "btn-light") rounded-circle shadow"
                        type="submit"
                        data-accion="@(Model.EsFavorito ? "quitar" : "agregar")"
                        title="@(Model.EsFavorito ? "Quitar de favoritos" : "Añadir a favoritos")"
                        aria-label="@(Model.EsFavorito ? "Quitar de favoritos" : "Añadir a favoritos")">
                    <i class="bi @(Model.EsFavorito ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            </form>
        }
        else
        {
            <a class="btn btn-light rounded-circle shadow position-absolute top-0 end-0 m-2 z-3"
               asp-page="/Cuenta/Login"
               asp-route-returnUrl="@retorno"
               title="Inicia sesión para guardarlo"
               aria-label="Inicia sesión para añadirlo a favoritos">
                <i class="bi bi-heart"></i>
            </a>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h2 class="h5 card-title">
            <a class="link-body-emphasis text-decoration-none"
               asp-page="/Libros/Detalles"
               asp-route-id="@Model.Id">
                @Model.Titulo
            </a>
        </h2>

        <p class="small mb-1">@Model.AutoresTexto</p>
        <p class="text-body-secondary small mb-3">
            @Model.AnioTexto
            @if (Model.NumeroEdiciones > 0)
            {
                <span>· @Model.NumeroEdiciones ediciones</span>
            }
        </p>

        <a class="btn btn-outline-primary mt-auto"
           asp-page="/Libros/Detalles"
           asp-route-id="@Model.Id">
            <i class="bi bi-info-circle me-1"></i>Ver ficha
        </a>
    </div>
</article>
