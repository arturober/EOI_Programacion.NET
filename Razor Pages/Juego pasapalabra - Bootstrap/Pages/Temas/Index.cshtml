@page
@model PasapalabraRazor.Pages.Temas.IndexModel
@{
    ViewData["Title"] = "Temas";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="text-primary fw-bold small mb-1">ADMINISTRACIÓN</p>
        <h1 class="h2 mb-0"><i class="bi bi-tags me-2"></i>Temas</h1>
    </div>
    <a class="btn btn-primary" asp-page="Crear"
       title="Nuevo tema" aria-label="Nuevo tema">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

@if (Model.Temas.Count == 0)
{
    <div class="alert alert-light border text-center py-5">
        <i class="bi bi-inbox fs-1 d-block text-secondary mb-2"></i>
        No hay temas que mostrar.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (PasapalabraRazor.Pages.Temas.TemaResumen item in Model.Temas)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-tag-fill text-primary fs-3"></i>
                        <h2 class="h4 card-title mt-2 text-break">@item.Tema.Nombre</h2>
                        <p class="card-text text-secondary text-break">@item.Tema.Descripcion</p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge rounded-pill text-bg-light border">
                                @item.Preguntas preguntas
                            </span>
                            <span class="badge rounded-pill text-bg-light border">
                                @item.Letras / 27 letras
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="Editar" asp-route-id="@item.Tema.Id"
                           title="Modificar" aria-label="Modificar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <form method="post" asp-page-handler="Borrar"
                              data-elemento="el tema" data-nombre="@item.Tema.Nombre"
                              onsubmit="return confirmarEliminacion(this)">
                            <input type="hidden" name="id" value="@item.Tema.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                    title="Eliminar" aria-label="Eliminar">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}
