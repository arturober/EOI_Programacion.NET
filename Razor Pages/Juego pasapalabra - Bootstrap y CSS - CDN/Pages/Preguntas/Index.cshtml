@page
@model PasapalabraRazor.Pages.Preguntas.IndexModel
@{
    ViewData["Title"] = "Preguntas";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="text-primary fw-bold small mb-1">ADMINISTRACIÓN</p>
        <h1 class="h2 mb-0"><i class="bi bi-question-circle me-2"></i>Preguntas</h1>
    </div>
    <a class="btn btn-primary" asp-page="Crear"
       title="Nueva pregunta" aria-label="Nueva pregunta">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <label asp-for="Buscar" class="form-label fw-bold">
        <i class="bi bi-search me-1"></i>Buscar en respuestas o definiciones
    </label>

    <input asp-for="Buscar"
           class="form-control"
           type="search"
           placeholder="Escribe una palabra..."
           autocomplete="off"
           autofocus
           onfocus="this.setSelectionRange(this.value.length, this.value.length); this.onfocus = null"
           oninput="clearTimeout(this.espera); this.espera = setTimeout(() => this.form.requestSubmit(), 300)" />
</form>

@if (Model.Preguntas.Count == 0)
{
    <div class="alert alert-light border text-center py-5">
        <i class="bi bi-inbox fs-1 d-block text-secondary mb-2"></i>
        No hay preguntas que mostrar.
    </div>
}
else
{
    <div class="table-responsive rounded shadow-sm border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="d-none d-md-table-cell">Letra</th>
                    <th scope="col">Pregunta</th>
                    <th scope="col" class="d-none d-lg-table-cell">Tema</th>
                    <th scope="col" class="text-end">
                        <span class="d-none d-sm-inline">Acciones</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (Pregunta pregunta in Model.Preguntas)
                {
                    <tr>
                        <td class="d-none d-md-table-cell">
                            <span class="letra-tabla">@pregunta.Letra</span>
                        </td>
                        <td class="text-break">
                            <div class="d-flex align-items-start gap-2">
                                <span class="letra-tabla d-md-none flex-shrink-0">
                                    @pregunta.Letra
                                </span>
                                <div>
                                    <strong class="d-block">@pregunta.Respuesta</strong>
                                    <small class="d-block text-secondary">@pregunta.Definicion</small>
                                    <span class="badge rounded-pill text-bg-light border d-lg-none mt-1">
                                        <i class="bi bi-tag me-1"></i>@pregunta.Tema.Nombre
                                    </span>
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="bi bi-tag me-1"></i>@pregunta.Tema.Nombre
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-page="Editar" asp-route-id="@pregunta.Id"
                               title="Modificar" aria-label="Modificar">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form method="post" asp-page-handler="Borrar"
                                  class="d-inline ms-1"
                                  data-elemento="la pregunta" data-nombre="@pregunta.Respuesta"
                                  onsubmit="return confirmarEliminacion(this)">
                                <input type="hidden" name="id" value="@pregunta.Id" />
                                <input type="hidden" name="Buscar" value="@Model.Buscar" />
                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                        title="Eliminar" aria-label="Eliminar">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
