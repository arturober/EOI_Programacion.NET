@page
@model PasapalabraRazor.Pages.Temas.CrearModel
@{
    ViewData["Title"] = "Nuevo tema";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <h1 class="h2 mb-4"><i class="bi bi-tag me-2"></i>Añadir tema</h1>

        <form method="post">
            @if (ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="TemaFormulario.Nombre" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="TemaFormulario.Nombre" class="form-control"
                           placeholder="Nombre del tema" autofocus />
                </div>
                <span asp-validation-for="TemaFormulario.Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="TemaFormulario.Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="TemaFormulario.Descripcion" class="form-control" rows="4"
                          placeholder="¿Qué tipo de preguntas contendrá?"></textarea>
                <span asp-validation-for="TemaFormulario.Descripcion" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"
                        title="Guardar" aria-label="Guardar">
                    <i class="bi bi-floppy me-2"></i>Guardar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary"
                   title="Cancelar" aria-label="Cancelar">
                    <i class="bi bi-x-lg me-2"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
