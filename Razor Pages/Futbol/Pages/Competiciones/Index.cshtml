@page
@model Futbol.Pages.Competiciones.IndexModel
@{
    ViewData["Title"] = "Competiciones";
}

<div class="mb-4">
    <p class="text-primary fw-semibold mb-1">Explorar</p>
    <h1 class="display-6 fw-bold">Competiciones disponibles</h1>
    <p class="text-body-secondary">
        La lista depende de las competiciones incluidas en tu plan.
    </p>
</div>

@if (Model.ErrorApi is not null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorApi
    </div>
}
else if (Model.Competiciones.Count == 0)
{
    <div class="alert alert-info">
        No se han encontrado competiciones para este token.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (CompeticionDto competicion in Model.Competiciones)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex gap-3">
                        <img src="@competicion.Emblema"
                             data-imagen
                             style="width: 72px; height: 72px; object-fit: contain;"
                             alt="Emblema de @competicion.Nombre" />
                        <div>
                            <span class="badge text-bg-secondary mb-2">
                                @(competicion.Area?.Nombre ?? "Internacional")
                            </span>
                            <h2 class="h5">@competicion.Nombre</h2>
                            <p class="small text-body-secondary mb-0">
                                @if (competicion.TemporadaActual?.JornadaActual is not null)
                                {
                                    <span>
                                        Jornada @competicion.TemporadaActual.JornadaActual
                                    </span>
                                }
                                else
                                {
                                    <span>@(competicion.Tipo ?? "Competición")</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a class="btn btn-primary w-100"
                           asp-page="/Competiciones/Detalles"
                           asp-route-codigo="@competicion.Codigo">
                            Consultar competición
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
}
