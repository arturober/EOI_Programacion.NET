@{
    // La ruta actual permite destacar la sección activa del menú.
    string pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool inicio = pagina == "/Index";
    bool acerca = pagina == "/Acerca";

    // Las páginas pueden enviar un mensaje para mostrarlo mediante SweetAlert.
    string? mensaje = ViewData["Mensaje"] as string ?? TempData["Mensaje"] as string;
    string? error = ViewData["Error"] as string ?? TempData["Error"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    @* Viewport hace que Bootstrap adapte la interfaz a móviles y ordenadores. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="Aplicación educativa de meteorología con Razor Pages y OpenWeather." />

    <title>@ViewData["Title"] - Open Weather</title>

    @* temas.js cambiará esta dirección al seleccionar un tema Bootswatch. *@
    <link id="temaCss"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    @* Bootstrap Icons proporciona los pictogramas de toda la interfaz. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    @* SweetAlert utiliza esta hoja para dibujar sus ventanas. *@
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css"
          rel="stylesheet" />
</head>
<body class="min-vh-100 d-flex flex-column"
      data-mensaje="@(error ?? mensaje)"
      data-icono="@(error is null ? "success" : "error")"
      data-titulo="@(error is null ? "Información" : "No se ha podido completar la consulta")">
    @* La barra queda visible al desplazar la página y se contrae en móvil. *@
    <nav class="navbar navbar-expand-lg bg-primary sticky-top shadow-sm"
         data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-cloud-sun-fill me-2"></i>Open Weather
            </a>

            @* Este botón abre el menú hamburguesa en pantallas pequeñas. *@
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Mostrar u ocultar el menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(inicio ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Index">
                            <i class="bi bi-speedometer2 me-1"></i>El tiempo
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(acerca ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Acerca">
                            <i class="bi bi-braces me-1"></i>Proyecto y API
                        </a>
                    </li>
                </ul>

                @* El selector cambia entre Bootstrap y todos los temas de Bootswatch. *@
                <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
                    <label for="selectorTema"
                           class="text-white fs-5"
                           title="Seleccionar el tema">
                        <i class="bi bi-palette" aria-hidden="true"></i>
                        <span class="visually-hidden">Tema</span>
                    </label>

                    <select id="selectorTema"
                            class="form-select form-select-sm"
                            aria-label="Seleccionar el tema">
                        <optgroup label="Bootstrap">
                            <option value="bootstrap-light">Bootstrap claro</option>
                            <option value="bootstrap-dark">Bootstrap oscuro</option>
                        </optgroup>
                        <optgroup label="Bootswatch">
                            <option value="bootswatch-brite">Brite</option>
                            <option value="bootswatch-cerulean">Cerulean</option>
                            <option value="bootswatch-cosmo">Cosmo</option>
                            <option value="bootswatch-cyborg">Cyborg</option>
                            <option value="bootswatch-darkly">Darkly</option>
                            <option value="bootswatch-flatly">Flatly</option>
                            <option value="bootswatch-journal">Journal</option>
                            <option value="bootswatch-litera">Litera</option>
                            <option value="bootswatch-lumen">Lumen</option>
                            <option value="bootswatch-lux">Lux</option>
                            <option value="bootswatch-materia">Materia</option>
                            <option value="bootswatch-minty">Minty</option>
                            <option value="bootswatch-morph">Morph</option>
                            <option value="bootswatch-pulse">Pulse</option>
                            <option value="bootswatch-quartz">Quartz</option>
                            <option value="bootswatch-sandstone">Sandstone</option>
                            <option value="bootswatch-simplex">Simplex</option>
                            <option value="bootswatch-sketchy">Sketchy</option>
                            <option value="bootswatch-slate">Slate</option>
                            <option value="bootswatch-solar">Solar</option>
                            <option value="bootswatch-spacelab">Spacelab</option>
                            <option value="bootswatch-superhero">Superhero</option>
                            <option value="bootswatch-united">United</option>
                            <option value="bootswatch-vapor">Vapor</option>
                            <option value="bootswatch-yeti">Yeti</option>
                            <option value="bootswatch-zephyr">Zephyr</option>
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
    </nav>

    @* RenderBody inserta aquí el contenido específico de cada Razor Page. *@
    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-4 mt-4">
        <div class="container text-center text-body-secondary small">
            <span class="d-block">
                Proyecto educativo desarrollado con ASP.NET Core y Razor Pages.
            </span>
            <a href="https://openweathermap.org/"
               target="_blank"
               rel="noopener"
               class="link-secondary">
                Weather data provided by OpenWeather
            </a>
        </div>
    </footer>

    @* El JavaScript de Bootstrap controla el menú y los componentes desplegables. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    @* SweetAlert se carga antes del archivo que llama a Swal.fire. *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>

    @* Los archivos propios se mantienen pequeños y separados por responsabilidad. *@
    <script src="~/js/temas.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert.js" asp-append-version="true"></script>

    @* Las páginas pueden añadir su propio JavaScript mediante esta sección. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
