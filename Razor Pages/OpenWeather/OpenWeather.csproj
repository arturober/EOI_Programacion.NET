<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Este identificador permite guardar la clave de OpenWeather mediante
      dotnet user-secrets sin escribirla dentro del proyecto.
    -->
    <UserSecretsId>OpenWeather-2026</UserSecretsId>
  </PropertyGroup>

</Project>
