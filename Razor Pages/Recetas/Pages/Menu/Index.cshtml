@page
@model global::Recetas.Pages.Menu.IndexModel
@{
    ViewData["Title"] = "Mi menú semanal";

    // La URL local permite volver aquí después de modificar el menú.
    string retorno =
        $"{ViewContext.HttpContext.Request.Path}"
        + $"{ViewContext.HttpContext.Request.QueryString}";
}

<header class="mb-4">
    <h1>
        <i class="bi bi-calendar-week text-primary me-2"></i>
        Mi menú semanal
    </h1>
    <p class="text-body-secondary">
        Asigna recetas desde sus fichas y genera automáticamente los ingredientes.
    </p>
</header>

<section class="mb-5">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (DiaMenu dia in Enum.GetValues<DiaMenu>())
        {
            MenuSemanal? elemento = Model.Menu.GetValueOrDefault(dia);

            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h5 mb-0">@dia.Titulo()</h2>
                    </div>

                    @if (elemento is not null)
                    {
                        <div class="ratio ratio-4x3 bg-body-tertiary">
                            @if (!string.IsNullOrWhiteSpace(elemento.Receta.ImagenUrl))
                            {
                                <img src="@elemento.Receta.ImagenUrl"
                                     class="w-100 h-100 object-fit-cover"
                                     alt="Imagen de @elemento.Receta.Nombre"
                                     data-imagen
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-egg-fried display-1 text-body-secondary"></i>
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h3 class="h6">@elemento.Receta.Nombre</h3>
                            <p class="small text-body-secondary">
                                @elemento.Receta.Categoria
                                @if (!string.IsNullOrWhiteSpace(elemento.Receta.Area))
                                {
                                    <span>· @elemento.Receta.Area</span>
                                }
                            </p>

                            <a class="btn btn-outline-primary btn-sm mt-auto"
                               asp-page="/Recetas/Detalles"
                               asp-route-id="@elemento.RecetaId">
                                Ver receta
                            </a>

                            <form method="post"
                                  asp-page="/Menu/Accion"
                                  class="mt-2"
                                  data-confirmar-dia="true">
                                <input type="hidden" name="accion" value="quitar" />
                                <input type="hidden" name="dia" value="@dia" />
                                <input type="hidden"
                                       name="returnUrl"
                                       value="@retorno" />
                                <button class="btn btn-outline-danger btn-sm w-100"
                                        type="submit">
                                    <i class="bi bi-x-lg me-1"></i>Vaciar día
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                            <i class="bi bi-plus-circle display-5 text-body-secondary"></i>
                            <p class="text-body-secondary mt-2 mb-3">
                                Sin receta
                            </p>
                            <a class="btn btn-outline-primary btn-sm"
                               asp-page="/Recetas/Categorias">
                                Buscar receta
                            </a>
                        </div>
                    }
                </article>
            </div>
        }
    </div>
</section>

<section class="card shadow-sm">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h4 mb-0">
            <i class="bi bi-cart3 me-2"></i>Lista de la compra
        </h2>
        @if (Model.ListaCompra.Count > 0)
        {
            <button class="btn btn-outline-primary btn-sm"
                    type="button"
                    onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Imprimir
            </button>
        }
    </div>

    <div class="card-body">
        @if (Model.ListaCompra.Count > 0)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                @foreach (ElementoCompra elemento in Model.ListaCompra)
                {
                    <div class="col">
                        <div class="form-check border rounded p-3 ps-5 h-100">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="compra-@elemento.Ingrediente.GetHashCode()" />
                            <label class="form-check-label"
                                   for="compra-@elemento.Ingrediente.GetHashCode()">
                                <strong>@elemento.Ingrediente</strong>
                                @if (elemento.Medidas.Count > 0)
                                {
                                    <span class="d-block small text-body-secondary">
                                        @string.Join(" + ", elemento.Medidas)
                                    </span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-cart-x display-3 text-body-secondary"></i>
                <p class="text-body-secondary mt-2 mb-0">
                    Añade recetas al menú para generar la lista.
                </p>
            </div>
        }
    </div>
</section>
