@model RecetaResumen
@{
    // Permite volver al mismo listado después de cambiar un favorito.
    string retorno =
        $"{ViewContext.HttpContext.Request.Path}"
        + $"{ViewContext.HttpContext.Request.QueryString}";
}

<article class="card h-100 shadow-sm">
    <div class="position-relative">
        <div class="ratio ratio-4x3 bg-body-tertiary">
            @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl"
                     class="w-100 h-100 object-fit-cover"
                     alt="Imagen de @Model.Nombre"
                     data-imagen
                     loading="lazy" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary">
                    <i class="bi bi-egg-fried display-1"></i>
                    <span>Sin imagen</span>
                </div>
            }
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post"
                  asp-page="/Favoritos/Accion"
                  class="position-absolute top-0 end-0 m-2 z-3"
                  data-confirmar-quitar="@(Model.EsFavorita ? "true" : null)">
                <input type="hidden" name="recetaId" value="@Model.Id" />
                <input type="hidden"
                       name="accion"
                       value="@(Model.EsFavorita ? "quitar" : "agregar")" />
                <input type="hidden" name="returnUrl" value="@retorno" />

                <button class="btn @(Model.EsFavorita ? "btn-danger" : "btn-light") rounded-circle shadow"
                        type="submit"
                        title="@(Model.EsFavorita ? "Quitar de favoritos" : "Añadir a favoritos")"
                        aria-label="@(Model.EsFavorita ? "Quitar de favoritos" : "Añadir a favoritos")">
                    <i class="bi @(Model.EsFavorita ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            </form>
        }
        else
        {
            <a class="btn btn-light rounded-circle shadow position-absolute top-0 end-0 m-2 z-3"
               asp-page="/Cuenta/Login"
               asp-route-returnUrl="@retorno"
               title="Inicia sesión para guardarla"
               aria-label="Inicia sesión para guardarla">
                <i class="bi bi-heart"></i>
            </a>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h2 class="h5 card-title">
            <a class="link-body-emphasis text-decoration-none"
               asp-page="/Recetas/Detalles"
               asp-route-id="@Model.Id">
                @Model.Nombre
            </a>
        </h2>

        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Categoria))
            {
                <span class="badge text-bg-primary">@Model.Categoria</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Area))
            {
                <span class="badge text-bg-secondary">@Model.Area</span>
            }
        </div>

        <a class="btn btn-outline-primary mt-auto"
           asp-page="/Recetas/Detalles"
           asp-route-id="@Model.Id">
            <i class="bi bi-card-list me-1"></i>Ver receta
        </a>
    </div>
</article>
