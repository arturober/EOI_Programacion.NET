@page
@model global::Recetas.Pages.Recetas.BuscarModel
@{
    ViewData["Title"] = "Buscar recetas";
}

<header class="mb-4">
    <h1>Buscar recetas</h1>
    <form method="get" class="mt-3" role="search">
        <div class="input-group input-group-lg">
            <input class="form-control"
                   name="texto"
                   value="@Model.Texto"
                   placeholder="Nombre de la receta"
                   aria-label="Texto que se desea buscar"
                   minlength="2"
                   autofocus
                   required />
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search me-1"></i>Buscar
            </button>
        </div>
    </form>
</header>

@if (Model.Texto.Length >= 2)
{
    <p class="text-body-secondary">
        @Model.Resultados.Count resultados para
        <strong>«@Model.Texto»</strong>.
    </p>

    @if (Model.Resultados.Count > 0)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (RecetaResumen receta in Model.Resultados)
            {
                <div class="col">
                    <partial name="_TarjetaReceta" model="receta" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown display-1 text-body-secondary"></i>
            <h2 class="h4 mt-3">No se han encontrado coincidencias</h2>
            <p class="text-body-secondary">
                TheMealDB utiliza nombres en inglés. Prueba con
                <em>chicken</em>, <em>pasta</em> o <em>cake</em>.
            </p>
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-egg-fried display-1 text-body-secondary"></i>
        <h2 class="h4 mt-3">¿Qué te apetece cocinar?</h2>
        <p class="text-body-secondary">
            Escribe al menos dos caracteres para empezar.
        </p>
    </div>
}
