@page
@model global::Recetas.Pages.Favoritos.IndexModel
@{
    ViewData["Title"] = "Mis favoritos";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <header>
        <h1><i class="bi bi-heart-fill text-danger me-2"></i>Mis favoritos</h1>
        <p class="text-body-secondary mb-0">
            Tus recetas guardadas en SQLite.
        </p>
    </header>

    @if (Model.Recetas.Count > 1)
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label for="orden" class="form-label mb-0">Ordenar</label>
            <select id="orden"
                    name="orden"
                    class="form-select"
                    onchange="this.form.submit()">
                @foreach ((string valor, string texto) opcion in new[]
                {
                    ("recientes", "Más recientes"),
                    ("titulo", "Título"),
                    ("categoria", "Categoría"),
                    ("area", "Cocina")
                })
                {
                    <option value="@opcion.valor"
                            selected="@(Model.Orden == opcion.valor ? "selected" : null)">
                        @opcion.texto
                    </option>
                }
            </select>
        </form>
    }
</div>

@if (Model.Recetas.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (RecetaResumen receta in Model.Recetas)
        {
            <div class="col">
                <partial name="_TarjetaReceta" model="receta" />
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 bg-body-tertiary">
        <div class="card-body text-center py-5">
            <i class="bi bi-heart display-1 text-body-secondary"></i>
            <h2 class="h4 mt-3">Todavía no tienes recetas favoritas</h2>
            <p class="text-body-secondary">
                Pulsa el corazón de cualquier tarjeta para guardarla.
            </p>
            <a class="btn btn-primary" asp-page="/Recetas/Categorias">
                Explorar recetas
            </a>
        </div>
    </div>
}
