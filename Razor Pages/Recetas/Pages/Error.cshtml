@page
@model global::Recetas.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-warning"></i>
    <h1 class="mt-3">Ha ocurrido un error inesperado</h1>
    <p class="lead text-body-secondary">
        La operación no se ha podido completar. Inténtalo de nuevo.
    </p>

    @if (Model.MostrarIdPeticion)
    {
        <p class="small">
            Identificador de la petición:
            <code>@Model.IdPeticion</code>
        </p>
    }

    <a class="btn btn-primary mt-2" asp-page="/Index">
        <i class="bi bi-house me-1"></i>Volver al inicio
    </a>
</div>
