@page "{id:int}"
@model ModificarTareaModel
@{
    ViewData["Title"] = "Modificar tarea";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <p class="text-primary fw-bold small mb-1">EDITAR TAREA</p>
        <h1 class="h2 mb-4"><i class="bi bi-pencil-square me-2"></i>Modificar tarea</h1>

        <form method="post">
            <input asp-for="Tarea.Id" type="hidden" />

            @if (ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="Tarea.Titulo" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                    <input asp-for="Tarea.Titulo" class="form-control" autofocus />
                </div>
                <span asp-validation-for="Tarea.Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tarea.Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="Tarea.Descripcion" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Tarea.Descripcion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                <select asp-for="CategoriaId" class="form-select">
                    @foreach (Categoria categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Tarea.Completada" class="form-check-input" />
                <label asp-for="Tarea.Completada" class="form-check-label">
                    Tarea completada
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"
                        title="Guardar" aria-label="Guardar">
                    <i class="bi bi-floppy me-2"></i>Guardar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary"
                   title="Cancelar" aria-label="Cancelar">
                    <i class="bi bi-x-lg me-2"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
