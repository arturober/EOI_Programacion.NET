@model RickAndMorty.DTOs.PersonajeDto

<article class="card h-100 shadow-sm">
    <img src="@Model.Imagen"
         data-imagen
         class="card-img-top"
         alt="Imagen de @Model.Nombre" />
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h2 class="h5 card-title">@Model.Nombre</h2>
            <span class="badge @TextoRickAndMorty.ClaseEstado(Model.Estado)">
                @TextoRickAndMorty.Estado(Model.Estado)
            </span>
        </div>
        <p class="card-text text-body-secondary mb-2">
            @Model.Especie
            @if (!string.IsNullOrWhiteSpace(Model.Tipo))
            {
                <span> · @Model.Tipo</span>
            }
        </p>
        <p class="small mb-0">
            <i class="bi bi-geo-alt me-1"></i>
            @Model.Localizacion.Nombre
        </p>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-primary w-100"
           asp-page="/Personajes/Detalles"
           asp-route-id="@Model.Id">
            Ver personaje
        </a>
    </div>
</article>
