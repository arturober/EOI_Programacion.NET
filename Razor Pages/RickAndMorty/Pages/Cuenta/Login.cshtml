@page
@model RickAndMorty.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle display-3 text-primary"></i>
                    <h1 class="h2 mt-2">Iniciar sesión</h1>
                    <p class="text-body-secondary">
                        Accede a tu colección de personajes.
                    </p>
                </div>

                <form method="post"
                      asp-route-returnUrl="@Model.ReturnUrl">
                    @* Sin validación en el cliente, el resumen solo debe
                       aparecer cuando el servidor haya encontrado errores. *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>
                    }

                    <div class="form-floating mb-3">
                        <input asp-for="Entrada.Email"
                               class="form-control"
                               autocomplete="email"
                               placeholder="nombre@ejemplo.com" />
                        <label asp-for="Entrada.Email"></label>
                        <span asp-validation-for="Entrada.Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Entrada.Contrasena"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Contraseña" />
                        <label asp-for="Entrada.Contrasena"></label>
                        <span asp-validation-for="Entrada.Contrasena"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Entrada.Recordarme"
                               class="form-check-input" />
                        <label asp-for="Entrada.Recordarme"
                               class="form-check-label"></label>
                    </div>

                    <button class="btn btn-primary btn-lg w-100"
                            type="submit">
                        Entrar
                    </button>
                </form>

                <p class="text-center mt-4 mb-0">
                    ¿No tienes cuenta?
                    <a asp-page="/Cuenta/Registro"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Regístrate
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
