@page
@model Preguntas.IndexModel
@{
    ViewData["Title"] = "Preguntas";
}

<header>
    <h1>Preguntas</h1>
</header>

<div class="row">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Pregunta</th>
                <th>Categoria</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Pregunta pregunta in Model.Preguntas)
            {
                <tr>
                    <td>@pregunta.Enunciado</td>
                    <td>
                        <span class="badge bg-secondary">
                            @pregunta.Categoria?.Nombre
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>