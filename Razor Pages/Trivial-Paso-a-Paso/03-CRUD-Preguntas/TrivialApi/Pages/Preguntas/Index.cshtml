@page
@model Preguntas.IndexModel
@{
    ViewData["Title"] = "Preguntas";
}

<header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Preguntas</h1>
        <p class="text-body-secondary mb-0">
            Se muestran las 25 primeras preguntas.
        </p>
    </div>

    <a class="btn btn-primary" asp-page="Crear">
        Nueva pregunta
    </a>
</header>

@* Bootstrap adapta la tabla y alinea verticalmente el contenido de sus filas. *@
<div class="table-responsive rounded shadow-sm border">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Pregunta</th>
                <th>Categoría</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Pregunta pregunta in Model.Preguntas)
            {
                <tr>
                    <td>@pregunta.Enunciado</td>
                    <td>
                        <span class="badge text-bg-secondary">
                            @pregunta.Categoria?.Nombre
                        </span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="Editar"
                           asp-route-id="@pregunta.Id">
                            Editar
                        </a>

                        @* La confirmación nativa se sustituirá por SweetAlert
                           en la última versión sin cambiar el método del servidor. *@
                        <form method="post"
                              asp-page-handler="Eliminar"
                              class="d-inline"
                              onsubmit="return confirm('¿Quieres eliminar esta pregunta?');">
                            <input type="hidden" name="id"
                                   value="@pregunta.Id" />
                            <button class="btn btn-sm btn-outline-danger"
                                    type="submit">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
