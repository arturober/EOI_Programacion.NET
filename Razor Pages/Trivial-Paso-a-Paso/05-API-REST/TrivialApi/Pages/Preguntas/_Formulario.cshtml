@model Pregunta

@* El enunciado ocupa una fila completa porque normalmente es el texto más largo. *@
<div class="mb-3">
    <label asp-for="Enunciado" class="form-label"></label>
    <textarea asp-for="Enunciado"
              class="form-control"
              rows="3"
              autofocus></textarea>
    <span asp-validation-for="Enunciado" class="text-danger"></span>
</div>

@* row y col-md-6 colocan dos campos por fila en pantallas medianas o grandes.
   En un móvil cada columna ocupa automáticamente todo el ancho disponible. *@
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Respuesta1" class="form-label"></label>
        <input asp-for="Respuesta1" class="form-control" />
        <span asp-validation-for="Respuesta1" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Respuesta2" class="form-label"></label>
        <input asp-for="Respuesta2" class="form-control" />
        <span asp-validation-for="Respuesta2" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Respuesta3" class="form-label"></label>
        <input asp-for="Respuesta3" class="form-control" />
        <span asp-validation-for="Respuesta3" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Respuesta4" class="form-label"></label>
        <input asp-for="Respuesta4" class="form-control" />
        <span asp-validation-for="Respuesta4" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="RespuestaCorrecta" class="form-label"></label>

        @* La aplicación guarda un número del 1 al 4, no el texto de la respuesta. *@
        <select asp-for="RespuestaCorrecta" class="form-select">
            <option value="1">Respuesta 1</option>
            <option value="2">Respuesta 2</option>
            <option value="3">Respuesta 3</option>
            <option value="4">Respuesta 4</option>
        </select>
        <span asp-validation-for="RespuestaCorrecta"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CategoriaId" class="form-label"></label>

        @* asp-items convierte la SelectList del PageModel en opciones HTML. *@
        <select asp-for="CategoriaId"
                asp-items="@(ViewData["Categorias"] as SelectList)"
                class="form-select">
            <option value="0">Selecciona una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
</div>

