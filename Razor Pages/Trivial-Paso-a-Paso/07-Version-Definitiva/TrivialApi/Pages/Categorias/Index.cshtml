@page
@model Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Categorías</h1>
        <p class="text-body-secondary mb-0">
            Cada categoría agrupa un conjunto de preguntas.
        </p>
    </div>

    @* asp-page genera el enlace a la página Crear de esta misma carpeta. *@
    <a class="btn btn-primary" asp-page="Crear">
        <i class="bi bi-plus-lg"></i>
        <span class="visually-hidden">Nueva categoría</span>
    </a>
</header>

@* table-responsive permite desplazar la tabla horizontalmente en móviles estrechos. *@
<div class="table-responsive rounded shadow-sm border">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Preguntas</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @* Razor genera una fila por cada objeto recibido desde el PageModel. *@
            @foreach (Categoria categoria in Model.Categorias)
            {
                <tr>
                    <td>
                        @* La categoría enlaza con todas sus preguntas en JSON. *@
                        <a href="/api/preguntas?categoriaId=@categoria.Id&cantidad=100"
                           target="_blank"
                           rel="noopener"
                           title="Abrir las preguntas de la categoría en JSON">
                            @categoria.Nombre
                        </a>
                    </td>
                    <td>
                        <span class="badge text-bg-secondary">
                            @categoria.Preguntas.Count
                        </span>
                    </td>
                    <td class="text-end text-nowrap">
                        @* asp-route-id incorpora el identificador a la dirección. *@
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="Editar"
                           asp-route-id="@categoria.Id"
                           title="Editar"
                           aria-label="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>

                        @* sweetalert.js identifica el formulario por su clase y
                           construye el mensaje con sus atributos data. *@
                        <form method="post"
                              asp-page-handler="Eliminar"
                              class="d-inline formulario-eliminar"
                              data-elemento="la categoría"
                              data-nombre="@categoria.Nombre"
                              data-aviso="También se eliminarán sus @categoria.Preguntas.Count preguntas.">
                            <input type="hidden" name="id"
                                   value="@categoria.Id" />
                            <button class="btn btn-sm btn-outline-danger"
                                    type="submit"
                                    title="Eliminar"
                                    aria-label="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
