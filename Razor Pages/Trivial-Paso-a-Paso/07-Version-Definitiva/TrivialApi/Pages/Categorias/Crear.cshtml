@page
@model Categorias.CrearModel
@{
    ViewData["Title"] = "Nueva categoría";
}

<section class="card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h2 mb-4">Nueva categoría</h1>

        @* method="post" hace que el envío ejecute OnPostAsync. *@
        <form method="post">
            @* ModelOnly reserva esta zona para errores generales del formulario. *@
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            @* El parcial evita duplicar el campo Nombre en Crear y Editar. *@
            <partial name="_Formulario" for="Categoria" />

            <button class="btn btn-primary" type="submit">
                Guardar
            </button>
            <a class="btn btn-outline-secondary" asp-page="Index">
                Cancelar
            </a>
        </form>
    </div>
</section>
