@page "{id:int}"
@model Preguntas.EditarModel
@{
    ViewData["Title"] = "Editar pregunta";
}

<section class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h2 mb-4">Editar pregunta</h1>

        <form method="post">
            @* El Id oculto identifica la pregunta que recibirá el UPDATE. *@
            <input asp-for="Pregunta.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <partial name="_Formulario"
                     for="Pregunta"
                     view-data="ViewData" />

            <div class="mt-4">
                <button class="btn btn-primary" type="submit">
                    Guardar
                </button>
                <a class="btn btn-outline-secondary" asp-page="Index">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</section>
