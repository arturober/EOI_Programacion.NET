@page
@model Preguntas.CrearModel
@{
    ViewData["Title"] = "Nueva pregunta";
}

<section class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h2 mb-4">Nueva pregunta</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            @* view-data permite que el parcial reciba también la SelectList. *@
            <partial name="_Formulario"
                     model="Model.Pregunta"
                     view-data="ViewData" />

            <div class="mt-4">
                <button class="btn btn-primary" type="submit">
                    Guardar
                </button>
                <a class="btn btn-outline-secondary" asp-page="Index">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</section>

