@{
    // Leemos la ruta actual para destacar la sección activa de la navegación.
    string pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool inicio = pagina == "/Index";
    bool preguntas = pagina.StartsWith("/Preguntas");
    bool categorias = pagina.StartsWith("/Categorias");

    // El script de SweetAlert leerá estos valores desde los atributos del body.
    string? mensaje = TempData["Mensaje"] as string;
    string? error = TempData["Error"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    @* Viewport hace que Bootstrap adapte el diseño al ancho del dispositivo. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="Proyecto educativo de preguntas de trivial." />

    @* Cada página establece su título mediante ViewData. *@
    <title>@ViewData["Title"] - Trivial</title>

    @* temas.js sustituirá href cuando se seleccione un tema Bootswatch. *@
    <link id="temaCss"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    @* Bootstrap Icons permite usar pictogramas sin imágenes propias. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    @* Esta hoja contiene los estilos de las ventanas de SweetAlert. *@
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css"
          rel="stylesheet" />
</head>
<body class="min-vh-100 d-flex flex-column"
      data-mensaje="@(error ?? mensaje)"
      data-icono="@(error is null ? "success" : "error")"
      data-titulo="@(error is null ? "Operación completada" : "Ha ocurrido un problema")">
    @* La barra se mantiene visible al desplazarse y se contrae en móvil. *@
    <nav class="navbar navbar-expand-lg bg-primary sticky-top shadow-sm"
         data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-patch-question-fill me-2"></i>Trivial API
            </a>

            @* Este botón controla el menú hamburguesa en pantallas pequeñas. *@
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Mostrar u ocultar el menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(inicio ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Index">
                            <i class="bi bi-house me-1"></i>Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(preguntas ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Preguntas/Index">
                            <i class="bi bi-question-circle me-1"></i>Preguntas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(categorias ? "bg-white text-primary fw-semibold" : "text-white")"
                           asp-page="/Categorias/Index">
                            <i class="bi bi-tags me-1"></i>Categorías
                        </a>
                    </li>
                </ul>

                @* El cliente es un documento HTML estático servido desde wwwroot. *@
                <a class="btn btn-light my-2 my-lg-0 me-lg-3"
                   href="/cliente/index.html">
                    <i class="bi bi-controller me-1"></i>Jugar
                </a>

                @* El label visible es solo un icono, pero conserva texto accesible. *@
                <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
                    <label for="selectorTema"
                           class="text-white fs-5"
                           title="Seleccionar el tema">
                        <i class="bi bi-palette" aria-hidden="true"></i>
                        <span class="visually-hidden">Tema</span>
                    </label>

                    <select id="selectorTema"
                            class="form-select"
                            aria-label="Seleccionar el tema">
                        <optgroup label="Bootstrap">
                            <option value="bootstrap-light">
                                Bootstrap claro
                            </option>
                            <option value="bootstrap-dark">
                                Bootstrap oscuro
                            </option>
                        </optgroup>
                        <optgroup label="Bootswatch">
                            <option value="bootswatch-brite">Brite</option>
                            <option value="bootswatch-cerulean">Cerulean</option>
                            <option value="bootswatch-cosmo">Cosmo</option>
                            <option value="bootswatch-cyborg">Cyborg</option>
                            <option value="bootswatch-darkly">Darkly</option>
                            <option value="bootswatch-flatly">Flatly</option>
                            <option value="bootswatch-journal">Journal</option>
                            <option value="bootswatch-litera">Litera</option>
                            <option value="bootswatch-lumen">Lumen</option>
                            <option value="bootswatch-lux">Lux</option>
                            <option value="bootswatch-materia">Materia</option>
                            <option value="bootswatch-minty">Minty</option>
                            <option value="bootswatch-morph">Morph</option>
                            <option value="bootswatch-pulse">Pulse</option>
                            <option value="bootswatch-quartz">Quartz</option>
                            <option value="bootswatch-sandstone">Sandstone</option>
                            <option value="bootswatch-simplex">Simplex</option>
                            <option value="bootswatch-sketchy">Sketchy</option>
                            <option value="bootswatch-slate">Slate</option>
                            <option value="bootswatch-solar">Solar</option>
                            <option value="bootswatch-spacelab">Spacelab</option>
                            <option value="bootswatch-superhero">Superhero</option>
                            <option value="bootswatch-united">United</option>
                            <option value="bootswatch-vapor">Vapor</option>
                            <option value="bootswatch-yeti">Yeti</option>
                            <option value="bootswatch-zephyr">Zephyr</option>
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
    </nav>

    @* RenderBody inserta aquí el contenido particular de cada Razor Page. *@
    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-4 mt-4">
        <div class="container text-center text-body-secondary small">
            Proyecto educativo desarrollado con ASP.NET Core,
            Razor Pages, Entity Framework Core y SQLite.
        </div>
    </footer>

    @* El JavaScript de Bootstrap hace funcionar el menú hamburguesa. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    @* SweetAlert se carga antes del código que llama a Swal.fire. *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>

    @* Los archivos propios se mantienen separados por responsabilidad. *@
    <script src="~/js/temas.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert.js" asp-append-version="true"></script>

    @* Cada página puede incorporar scripts adicionales mediante esta sección. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
