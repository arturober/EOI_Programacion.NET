@page "{id:int}"
@model Preguntas.EditarModel
@{
    ViewData["Title"] = "Editar pregunta";
}

<section class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title">Editar pregunta</h1>
        <form method="post">
            <input asp-for="Pregunta.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_Formulario" for="Pregunta" />

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</section>
