@page
@model global::OpenFoodFacts.Pages.Productos.ListadoModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Titulo)
        ? "Productos"
        : Model.Titulo;
}

<header class="mb-4">
    <nav aria-label="Migas de pan">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
            <li class="breadcrumb-item">
                <a asp-page="/Productos/Categorias">Explorar</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @Model.Titulo
            </li>
        </ol>
    </nav>
    <h1>@Model.Titulo</h1>
    <p class="text-body-secondary">
        @Model.Resultado.Total productos encontrados.
    </p>
</header>

@if (Model.Resultado.Productos.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (ProductoResumen producto in Model.Resultado.Productos)
        {
            <div class="col">
                <partial name="_TarjetaProducto" model="producto" />
            </div>
        }
    </div>

    <partial name="_Paginacion" model="Model.Paginacion" />
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-search display-1 text-body-secondary"></i>
        <h2 class="h4 mt-3">No hay productos que mostrar</h2>
        <a class="btn btn-success mt-2" asp-page="/Index">
            Volver al inicio
        </a>
    </div>
}
