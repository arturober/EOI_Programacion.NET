@page
@model global::OpenFoodFacts.Pages.Productos.CategoriasModel
@{
    ViewData["Title"] = "Categorías";
}

<header class="mb-4">
    <h1>Categorías de productos</h1>
    <p class="text-body-secondary">
        Explora algunos de los grupos más habituales en Open Food Facts.
    </p>
</header>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (CategoriaProducto categoria in Model.Categorias)
    {
        <div class="col">
            <a class="card h-100 text-decoration-none shadow-sm"
               asp-page="/Productos/Listado"
               asp-route-tipo="categoria"
               asp-route-valor="@categoria.Filtro">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi @categoria.Icono display-5 text-success"></i>
                        <div>
                            <h2 class="h5 text-body mb-1">@categoria.Nombre</h2>
                            <p class="text-body-secondary mb-0">
                                @categoria.Descripcion
                            </p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
