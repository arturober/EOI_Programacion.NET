@model Paginacion

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-5" aria-label="Paginación de productos">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                <a class="page-link"
                   asp-page="@Model.PaginaRazor"
                   asp-route-pagina="@(Model.Pagina - 1)"
                   asp-route-texto="@Model.Texto"
                   asp-route-tipo="@Model.Tipo"
                   asp-route-valor="@Model.Valor">
                    <i class="bi bi-chevron-left me-1"></i>Anterior
                </a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">
                    Página @Model.Pagina de @Model.TotalPaginas
                </span>
            </li>
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                <a class="page-link"
                   asp-page="@Model.PaginaRazor"
                   asp-route-pagina="@(Model.Pagina + 1)"
                   asp-route-texto="@Model.Texto"
                   asp-route-tipo="@Model.Tipo"
                   asp-route-valor="@Model.Valor">
                    Siguiente<i class="bi bi-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>
}
