@model ProductoResumen
@{
    // Permite volver al mismo listado después de cambiar un favorito.
    string retorno =
        $"{ViewContext.HttpContext.Request.Path}"
        + $"{ViewContext.HttpContext.Request.QueryString}";
}

<article class="card h-100 shadow-sm">
    <div class="position-relative">
        <div class="ratio ratio-4x3 bg-body-tertiary">
            @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl"
                     class="w-100 h-100 object-fit-contain p-3"
                     alt="Envase de @Model.Nombre"
                     data-imagen
                     loading="lazy" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary">
                    <i class="bi bi-basket2 display-1"></i>
                    <span>Sin imagen</span>
                </div>
            }
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post"
                  asp-page="/Favoritos/Accion"
                  class="position-absolute top-0 end-0 m-2 z-3"
                  data-confirmar-quitar="@(Model.EsFavorito ? "true" : null)">
                <input type="hidden" name="codigo" value="@Model.Codigo" />
                <input type="hidden"
                       name="accion"
                       value="@(Model.EsFavorito ? "quitar" : "agregar")" />
                <input type="hidden" name="returnUrl" value="@retorno" />

                <button class="btn @(Model.EsFavorito ? "btn-danger" : "btn-light") rounded-circle shadow"
                        type="submit"
                        title="@(Model.EsFavorito ? "Quitar de favoritos" : "Añadir a favoritos")"
                        aria-label="@(Model.EsFavorito ? "Quitar de favoritos" : "Añadir a favoritos")">
                    <i class="bi @(Model.EsFavorito ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            </form>
        }
        else
        {
            <a class="btn btn-light rounded-circle shadow position-absolute top-0 end-0 m-2 z-3"
               asp-page="/Cuenta/Login"
               asp-route-returnUrl="@retorno"
               title="Inicia sesión para guardarlo"
               aria-label="Inicia sesión para guardarlo">
                <i class="bi bi-heart"></i>
            </a>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h2 class="h5 card-title">
            <a class="link-body-emphasis text-decoration-none"
               asp-page="/Productos/Detalles"
               asp-route-codigo="@Model.Codigo">
                @Model.Nombre
            </a>
        </h2>

        @if (!string.IsNullOrWhiteSpace(Model.Marca))
        {
            <p class="small text-body-secondary mb-2">@Model.Marca</p>
        }

        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge @Model.NutriScore.ClaseNutriScore()">
                @Model.NutriScore.TextoNutriScore()
            </span>
            <span class="badge @Model.GrupoNova.ClaseNova()"
                  title="@Model.GrupoNova.TextoNova()">
                @(Model.GrupoNova.HasValue ? $"NOVA {Model.GrupoNova}" : "NOVA ?")
            </span>
        </div>

        <div class="small text-body-secondary mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Cantidad))
            {
                <span class="me-2">
                    <i class="bi bi-box-seam me-1"></i>@Model.Cantidad
                </span>
            }
            <span><i class="bi bi-upc-scan me-1"></i>@Model.Codigo</span>
        </div>

        <a class="btn btn-outline-primary mt-auto"
           asp-page="/Productos/Detalles"
           asp-route-codigo="@Model.Codigo">
            <i class="bi bi-card-list me-1"></i>Ver información
        </a>
    </div>
</article>
