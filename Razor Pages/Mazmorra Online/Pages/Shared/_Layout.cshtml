<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - Mazmorra Online</title>

    @* Bootstrap oscuro es el tema inicial. tema.js puede cambiar esta URL. *@
    <link id="hojaTema"
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous" />

    @* Bootstrap Icons permite usar iconos sin guardar fuentes en el servidor. *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    @* Cada página puede añadir su CSS específico mediante esta sección. *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* La navbar se convierte automáticamente en un menú hamburguesa. *@
    <header id="cabeceraPrincipal">
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
            <div class="container">
                <a asp-page="/Index" class="navbar-brand fw-bold">
                    <i class="bi bi-controller me-2"></i>Mazmorra Online
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar u ocultar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="menuPrincipal"
                     class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a asp-page="/Index" class="nav-link">
                                <i class="bi bi-house-door me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-page="/Mapas" class="nav-link">
                                <i class="bi bi-map me-1"></i>Mapas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-page="/Rondas" class="nav-link">
                                <i class="bi bi-trophy me-1"></i>Rondas
                            </a>
                        </li>
                    </ul>

                    @* El selector cambia entre Bootstrap y todos los temas Bootswatch. *@
                    <div class="d-flex align-items-center gap-2">
                        <label for="selectorTema"
                               class="small text-body-secondary">
                            Tema
                        </label>
                        <select id="selectorTema"
                                class="form-select form-select-sm"
                                aria-label="Seleccionar el tema visual">
                            <option value="bootstrap-oscuro" selected>
                                Bootstrap oscuro
                            </option>
                            <option value="bootstrap-claro">
                                Bootstrap claro
                            </option>
                            <optgroup label="Bootswatch">
                                <option value="brite">Brite</option>
                                <option value="cerulean">Cerulean</option>
                                <option value="cosmo">Cosmo</option>
                                <option value="cyborg">Cyborg</option>
                                <option value="darkly">Darkly</option>
                                <option value="flatly">Flatly</option>
                                <option value="journal">Journal</option>
                                <option value="litera">Litera</option>
                                <option value="lumen">Lumen</option>
                                <option value="lux">Lux</option>
                                <option value="materia">Materia</option>
                                <option value="minty">Minty</option>
                                <option value="morph">Morph</option>
                                <option value="pulse">Pulse</option>
                                <option value="quartz">Quartz</option>
                                <option value="sandstone">Sandstone</option>
                                <option value="simplex">Simplex</option>
                                <option value="sketchy">Sketchy</option>
                                <option value="slate">Slate</option>
                                <option value="solar">Solar</option>
                                <option value="spacelab">Spacelab</option>
                                <option value="superhero">Superhero</option>
                                <option value="united">United</option>
                                <option value="vapor">Vapor</option>
                                <option value="yeti">Yeti</option>
                                <option value="zephyr">Zephyr</option>
                            </optgroup>
                        </select>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* RenderBody coloca aquí el contenido de la Razor Page actual. *@
    <main id="contenidoPrincipal" class="container py-4">
        @RenderBody()
    </main>

    <footer id="piePrincipal"
            class="border-top py-3 text-center text-body-secondary small">
        Desarrollado con .NET, Razor Pages, Canvas y SignalR
    </footer>

    @* El bundle incluye Bootstrap y Popper para navbar, modal y otros componentes. *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>

    @* Este pequeño script aplica y recuerda el tema seleccionado. *@
    <script src="~/js/tema.js" asp-append-version="true"></script>

    @* La página Juego utiliza esta sección para SignalR y el canvas. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
