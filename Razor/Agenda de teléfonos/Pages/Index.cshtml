@page
@model IndexModel
@{
    ViewData["Title"] = "Contactos";
}

<div class="table-responsive rounded shadow-sm border">
    <table class="table table-hover align-iddle mb-0 bg-white">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AgendaContactosWeb.Models.Persona persona in Model.Personas)
            {
                <tr>
                    <td>@persona.Nombre</td>
                    <td>@persona.Telefono</td>
                    <td class="text-center">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Editar" asp-route-id="@persona.Id">
                            <i class="bi bi-pencil"></i> Editar
                        </a>

                        <form class="formulario-eliminar" method="post" asp-page-handler="Eliminar">
                            <input type="hidden" name="id" value="@persona.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
