@page
@model IndexModel
@{
    ViewData["Title"] = "Contactos";
}

<div class="mb-4">
    <p class="text-primary fw-bold small mb-1">GESTIÓN DE CONTACTOS</p>
    <h1 class="h2 mb-0">
        <i class="bi bi-people me-2"></i>Mis contactos
    </h1>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <label asp-for="Busqueda" class="form-label fw-bold">
        <i class="bi bi-search me-1"></i>Buscar por nombre
    </label>

    <input asp-for="Busqueda"
           class="form-control"
           type="search"
           placeholder="Escribe un nombre..."
           autocomplete="off"
           autofocus
           oninput="clearTimeout(this.espera); this.espera = setTimeout(() => this.form.requestSubmit(), 300)" />
</form>

<div class="table-responsive rounded shadow-sm border">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-light">
            <tr>
                <th scope="col">Contacto</th>
                <th scope="col" class="d-none d-lg-table-cell">Teléfono</th>
                <th scope="col" class="text-end">
                    <span class="d-none d-sm-inline">Acciones</span>
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (Persona persona in Model.Personas)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            @if (persona.ImagenBase64 != null)
                            {
                                <img src="@persona.ObtenerImagenComoDataUrl()"
                                     class="rounded-circle object-fit-cover border flex-shrink-0"
                                     width="48"
                                     height="48"
                                     alt="Imagen de @persona.Nombre" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle text-secondary fs-1 flex-shrink-0"></i>
                            }

                            <div>
                                <strong class="d-block text-break">
                                    @persona.Nombre
                                </strong>

                                <a class="d-lg-none text-decoration-none text-nowrap"
                                   href="tel:@persona.Telefono">
                                    <i class="bi bi-telephone me-1"></i>@persona.Telefono
                                </a>
                            </div>
                        </div>
                    </td>

                    <td class="d-none d-lg-table-cell text-nowrap">
                        <a class="text-decoration-none"
                           href="tel:@persona.Telefono">
                            <i class="bi bi-telephone me-1"></i>@persona.Telefono
                        </a>
                    </td>

                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="/Editar" asp-route-id="@persona.Id"
                           title="Modificar" aria-label="Modificar">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <form method="post"
                              asp-page-handler="Eliminar"
                              class="d-inline ms-1"
                              data-nombre="@persona.Nombre"
                              onsubmit="return confirmarEliminacion(this)">
                            <input type="hidden" name="id" value="@persona.Id" />
                            <input type="hidden" name="Busqueda" value="@Model.Busqueda" />

                            <button class="btn btn-sm btn-outline-danger"
                                    type="submit"
                                    title="Eliminar"
                                    aria-label="Eliminar">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>