<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agenda_de_teléfonos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />

</head>
<body>
    <header class="navbar navbar-expand-md sticky-top bg-white border-bottom shadow-sm">
        <nav class="container">
            <a class="navbar-brand fw-bold text-primary" asp-page="/Index">
                <i class="bi bi-person-plus me-2"></i>Agenda de teléfonos
            </a>

            <a class="btn btn-primary" asp-page="/Crear">
                <i class="bi bi-person-plus me-2"></i>Añadir contacto
            </a>
        </nav>

    </header>

    <main role="main" class="container flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4 text-center text-secondary">
        <i class="bi bi-code-slash me-2"></i>
        Desarrollado con C#, Razor Pages, Bootstrap, SQLite, y SweetAlert2
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>

</body>
</html>
