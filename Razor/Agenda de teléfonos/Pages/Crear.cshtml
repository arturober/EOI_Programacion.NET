@page
@model CrearModel
@{
    ViewData["Title"] = "Añadir contacto";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <p class="text-primary fw-bold small mb-1">NUEVO CONTACTO</p>
        <h1 class="h2 mb-4"><i class="bi bi-person-plus me-2"></i>Añadir contacto</h1>

        <form method="post" enctype="multipart/form-data">
            @if (ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="Persona.Nombre" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Persona.Nombre" class="form-control" placeholder="Nombre y apellidos" autofocus />
                </div>
                <span asp-validation-for="Persona.Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Persona.Telefono" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Persona.Telefono" class="form-control" type="tel"
                           placeholder="Número de teléfono" />
                </div>
                <span asp-validation-for="Persona.Telefono" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenSubida" class="form-label fw-bold">
                    Imagen <span class="text-secondary fw-normal">(opcional)</span>
                </label>
                <input asp-for="ImagenSubida" class="form-control" type="file"
                       accept="image/jpeg,image/png,image/webp,image/gif" />
                <div class="form-text">
                    Formatos JPG, PNG, WEBP o GIF. Máximo 2 MB.
                    La imagen se reducirá a 48 píxeles de ancho.
                </div>
                <span asp-validation-for="ImagenSubida" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-2"></i>Guardar
                </button>
                <a asp-page="/Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
