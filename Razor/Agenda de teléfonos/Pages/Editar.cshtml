@page "{id:int}"
@model EditarModel
@{
    ViewData["Title"] = "Modificar contacto";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <p class="text-primary fw-bold small mb-1">EDITAR CONTACTO</p>
        <h1 class="h2 mb-4"><i class="bi bi-pencil-square me-2"></i>Modificar contacto</h1>

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Persona.Id" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="Persona.Nombre" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Persona.Nombre" class="form-control" autofocus />
                </div>
                <span asp-validation-for="Persona.Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Persona.Telefono" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Persona.Telefono" class="form-control" type="tel" />
                </div>
                <span asp-validation-for="Persona.Telefono" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenSubida" class="form-label fw-bold">Imagen</label>

                @if (Model.Persona.ImagenBase64 != null)
                {
                    <div class="mb-3">
                        <img src="@Model.Persona.ObtenerImagenComoDataUrl()"
                             class="rounded-circle object-fit-cover border shadow-sm"
                             width="48" height="48" alt="Imagen actual de @Model.Persona.Nombre" />
                    </div>
                }

                <input asp-for="ImagenSubida" class="form-control" type="file"
                       accept="image/jpeg,image/png,image/webp,image/gif" />
                <div class="form-text">
                    Selecciona otra imagen para sustituir la actual. Máximo 2 MB
                    y 48 píxeles de ancho después de procesarla.
                </div>
                <span asp-validation-for="ImagenSubida" class="text-danger small"></span>

                @if (Model.Persona.ImagenBase64 != null)
                {
                    <div class="form-check mt-3">
                        <input asp-for="EliminarImagen" class="form-check-input" />
                        <label asp-for="EliminarImagen" class="form-check-label">
                            Eliminar la imagen actual
                        </label>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-2"></i>Guardar cambios
                </button>
                <a asp-page="/Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
