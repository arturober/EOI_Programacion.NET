@page
@model CrearCategoriaModel
@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <p class="text-primary fw-bold small mb-1">NUEVA CATEGORÍA</p>
        <h1 class="h2 mb-4"><i class="bi bi-tag me-2"></i>Añadir categoría</h1>

        <form method="post">
            @if (ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="Categoria.Nombre" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="Categoria.Nombre" class="form-control"
                           placeholder="Nombre de la categoría" autofocus />
                </div>
                <span asp-validation-for="Categoria.Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Categoria.Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="Categoria.Descripcion" class="form-control" rows="4"
                          placeholder="¿Qué tipo de tareas contendrá?"></textarea>
                <span asp-validation-for="Categoria.Descripcion" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"
                        title="Guardar" aria-label="Guardar">
                    <i class="bi bi-floppy"></i>
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary"
                   title="Cancelar" aria-label="Cancelar">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>
