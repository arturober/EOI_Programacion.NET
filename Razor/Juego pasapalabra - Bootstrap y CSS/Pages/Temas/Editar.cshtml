@page "{id:int}"
@model PasapalabraRazor.Pages.Temas.EditarModel
@{
    ViewData["Title"] = "Modificar tema";
}

<div class="card shadow-sm col-lg-7 mx-auto">
    <div class="card-body p-4">
        <p class="text-primary fw-bold small mb-1">EDITAR TEMA</p>
        <h1 class="h2 mb-4"><i class="bi bi-pencil-square me-2"></i>Modificar tema</h1>

        <form method="post">
            <input asp-for="TemaFormulario.Id" type="hidden" />

            @if (ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="TemaFormulario.Nombre" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="TemaFormulario.Nombre" class="form-control" autofocus />
                </div>
                <span asp-validation-for="TemaFormulario.Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="TemaFormulario.Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="TemaFormulario.Descripcion" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TemaFormulario.Descripcion" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"
                        title="Guardar" aria-label="Guardar">
                    <i class="bi bi-floppy"></i>
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary"
                   title="Cancelar" aria-label="Cancelar">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>
