@page "{id:guid}"
@model global::Equipos.Pages.Equipos.DeleteModel
@{
    ViewData["Title"] = "Confirmar Eliminación de Equipo";
}

<div class="page-header">
    <div>
        <h1 class="page-title" style="color: #f87171;">🗑️ Eliminar Equipo</h1>
        <p class="page-subtitle">Confirma la eliminación permanente del equipo</p>
    </div>
    <a asp-page="./Index" class="btn-esports btn-secondary">⬅️ Cancelar</a>
</div>

<div class="form-card" style="border-color: rgba(239, 68, 68, 0.4);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <h2 style="color: #ffffff; font-size: 1.5rem;">¿Estás seguro de que deseas eliminar "@Model.Equipo.Nombre"?</h2>
        <p style="color: var(--text-muted); margin-top: 0.5rem;">
            Esta acción eliminará el equipo de <strong>@Model.Equipo.Juego</strong> y sus <strong>@Model.Equipo.Jugadores.Count jugador(es) asociados</strong> de forma permanente.
        </p>
    </div>

    <form method="post" style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
        <button type="submit" class="btn-esports btn-danger">🔥 Sí, Eliminar Definitivamente</button>
        <a asp-page="./Index" class="btn-esports btn-secondary">Cancelar y Volver</a>
    </form>
</div>
