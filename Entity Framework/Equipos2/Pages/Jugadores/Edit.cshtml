@page "{id:guid}"
@model global::Equipos.Pages.Jugadores.EditModel
@{
    ViewData["Title"] = "Editar Jugador";
}

<div class="page-header">
    <div>
        <h1 class="page-title">✏️ Editar Jugador</h1>
        <p class="page-subtitle">Modifica la información y equipo asignado al participante</p>
    </div>
    <a asp-page="./Index" class="btn-esports btn-secondary">⬅️ Volver a la Lista</a>
</div>

<div class="form-card">
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>

        <div class="form-group">
            <label asp-for="Input.Nickname" class="form-label">Nickname / In-Game Name (IGN)</label>
            <input asp-for="Input.Nickname" class="form-control" />
            <span asp-validation-for="Input.Nickname" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.NombreCompleto" class="form-label">Nombre Completo</label>
            <input asp-for="Input.NombreCompleto" class="form-control" />
            <span asp-validation-for="Input.NombreCompleto" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Rol" class="form-label">Rol en el Juego</label>
            <input asp-for="Input.Rol" class="form-control" />
            <span asp-validation-for="Input.Rol" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.EquipoId" class="form-label">Equipo de Pertenece</label>
            <select asp-for="Input.EquipoId" asp-items="Model.EquiposOptions" class="form-control"></select>
            <span asp-validation-for="Input.EquipoId" class="text-danger"></span>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn-esports btn-primary">💾 Guardar Cambios</button>
            <a asp-page="./Index" class="btn-esports btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
