@page "{id:guid}"
@model global::Equipos.Pages.Jugadores.DeleteModel
@{
    ViewData["Title"] = "Confirmar Eliminación de Jugador";
}

<div class="page-header">
    <div>
        <h1 class="page-title" style="color: #f87171;">🗑️ Eliminar Jugador</h1>
        <p class="page-subtitle">Confirma la baja del participante</p>
    </div>
    <a asp-page="./Index" class="btn-esports btn-secondary">⬅️ Cancelar</a>
</div>

<div class="form-card" style="border-color: rgba(239, 68, 68, 0.4);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <h2 style="color: #ffffff; font-size: 1.5rem;">¿Estás seguro de eliminar a "@Model.Jugador.Nickname"?</h2>
        <p style="color: var(--text-muted); margin-top: 0.5rem;">
            El participante <strong>@Model.Jugador.NombreCompleto</strong> (@Model.Jugador.Rol) será removido del equipo <strong>@Model.Jugador.NombreEquipo</strong>.
        </p>
    </div>

    <form method="post" style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
        <button type="submit" class="btn-esports btn-danger">🔥 Sí, Dar de Baja</button>
        <a asp-page="./Index" class="btn-esports btn-secondary">Cancelar</a>
    </form>
</div>
