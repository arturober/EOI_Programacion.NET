@page "{id:guid}"
@model DeleteModel
@{
    ViewData["Title"] = "Eliminar Asignatura";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="page-header">
            <div>
                <h1 class="page-title text-danger">Eliminar Asignatura</h1>
                <p class="page-subtitle">Confirma la eliminación de la asignatura seleccionada</p>
            </div>
            <a asp-page="./Index" class="btn-secondary-custom">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-custom border-danger">
            <div class="alert-custom alert-danger-custom mb-4">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <div>
                    <strong>¿Estás seguro de que deseas eliminar esta asignatura?</strong>
                    <div class="small">Esta acción desvinculará a todos los alumnos matriculados y borrará la asignatura del sistema.</div>
                </div>
            </div>

            <div class="bg-light p-3 rounded mb-4">
                <h5 class="fw-bold mb-1">@Model.Asignatura.Nombre</h5>
                <p class="mb-1 text-muted"><strong>Código:</strong> <code>@Model.Asignatura.Codigo</code></p>
                <p class="mb-1 text-muted"><strong>Créditos:</strong> @Model.Asignatura.Creditos ECTS</p>
                <p class="mb-0 text-muted"><strong>Alumnos matriculados:</strong> @Model.Asignatura.Alumnos.Count</p>
            </div>

            <form method="post">
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn-secondary-custom">Cancelar</a>
                    <button type="submit" class="btn-danger-custom">
                        <i class="bi bi-trash-fill"></i> Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
