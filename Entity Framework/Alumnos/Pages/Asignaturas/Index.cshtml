@page
@model IndexModel
@{
    ViewData["Title"] = "Catálogo de Asignaturas";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Asignaturas</h1>
        <p class="page-subtitle">Catálogo completo de asignaturas académicas y sus alumnos matriculados</p>
    </div>
    <a asp-page="./Create" class="btn-primary-custom">
        <i class="bi bi-journal-plus"></i> Nueva Asignatura
    </a>
</div>

<div class="card-custom">
    @if (Model.Asignaturas.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x text-muted fs-1 mb-3 d-block"></i>
            <h5 class="fw-bold">No hay asignaturas creadas</h5>
            <p class="text-muted mb-4">Crea una nueva asignatura para comenzar a recibir matrículas.</p>
            <a asp-page="./Create" class="btn-primary-custom">
                <i class="bi bi-journal-plus"></i> Crear Asignatura
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre de la Asignatura</th>
                        <th>Créditos</th>
                        <th>Alumnos Matriculados</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Asignaturas)
                    {
                        <tr>
                            <td><code>@item.Codigo</code></td>
                            <td class="fw-bold text-dark">@item.Nombre</td>
                            <td>
                                <span class="badge-custom badge-primary">@item.Creditos ECTS</span>
                            </td>
                            <td>
                                <span class="badge-custom badge-info">
                                    <i class="bi bi-people-fill me-1"></i> @item.AlumnosCount inscritos
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill me-1" title="Ver Detalles y Lista de Alumnos">
                                    <i class="bi bi-eye-fill"></i> Detalle
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill me-1" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill" title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
