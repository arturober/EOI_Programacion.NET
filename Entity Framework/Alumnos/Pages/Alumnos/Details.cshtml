@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = $"Ficha de {Model.Alumno.Nombre}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Alumno.Nombre</h1>
        <p class="page-subtitle">Detalle del alumno y gestión de asignaturas matriculadas</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Alumno.Id" class="btn-secondary-custom">
            <i class="bi bi-pencil-fill"></i> Editar
        </a>
        <a asp-page="./Index" class="btn-secondary-custom">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Información Personal -->
    <div class="col-lg-4">
        <div class="card-custom h-100">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 56px; height: 56px;">
                    @Model.Alumno.Nombre[0]
                </div>
                <div>
                    <h5 class="fw-bold m-0">@Model.Alumno.Nombre</h5>
                    <span class="badge-custom badge-primary mt-1">Estudiante Activo</span>
                </div>
            </div>

            <div class="border-top pt-3">
                <div class="mb-3">
                    <span class="text-muted small d-block">Correo Electrónico</span>
                    <strong class="text-dark">@Model.Alumno.Email</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">Documento DNI/NIE</span>
                    <code>@Model.Alumno.Dni</code>
                </div>
                <div>
                    <span class="text-muted small d-block">Total Créditos Matriculados</span>
                    <strong class="text-primary fs-5">
                        @Model.Alumno.Asignaturas.Sum(a => a.Creditos) ECTS
                    </strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Asignaturas Matriculadas y Opción de Matricular -->
    <div class="col-lg-8">
        <!-- Asignaturas actuales -->
        <div class="card-custom mb-4">
            <h4 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                <span><i class="bi bi-book-half text-primary me-2"></i> Asignaturas Matriculadas</span>
                <span class="badge-custom badge-info fs-6">@Model.Alumno.Asignaturas.Count asignaturas</span>
            </h4>

            @if (Model.Alumno.Asignaturas.Count == 0)
            {
                <div class="alert alert-light text-center py-4 border">
                    <p class="text-muted m-0">Este alumno aún no se ha matriculado en ninguna asignatura.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Asignatura</th>
                                <th>Créditos</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model.Alumno.Asignaturas)
                            {
                                <tr>
                                    <td><code>@sub.Codigo</code></td>
                                    <td class="fw-bold">@sub.Nombre</td>
                                    <td><span class="badge-custom badge-primary">@sub.Creditos ECTS</span></td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="Unenroll" asp-route-id="@Model.Alumno.Id" asp-route-asignaturaId="@sub.Id" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('¿Desmatricular al alumno de esta asignatura?');">
                                                <i class="bi bi-x-circle-fill me-1"></i> Desmatricular
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Matricular en nuevas asignaturas -->
        <div class="card-custom">
            <h4 class="fw-bold mb-3"><i class="bi bi-plus-circle-fill text-success me-2"></i> Matricular en Nuevas Asignaturas</h4>

            @if (Model.AvailableAsignaturas.Count == 0)
            {
                <p class="text-muted m-0">El alumno ya se encuentra matriculado en todas las asignaturas disponibles o no hay asignaturas registradas.</p>
            }
            else
            {
                <form method="post" asp-page-handler="Enroll" asp-route-id="@Model.Alumno.Id">
                    <p class="text-muted small mb-3">Selecciona las asignaturas que deseas añadir a la matrícula del alumno:</p>
                    
                    <div class="row g-2 mb-4">
                        @foreach (var sub in Model.AvailableAsignaturas)
                        {
                            <div class="col-md-6">
                                <div class="border rounded p-3 d-flex align-items-center justify-content-between background-surface">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedAsignaturaIds" value="@sub.Id" id="sub_@sub.Id" />
                                        <label class="form-check-label fw-semibold" for="sub_@sub.Id">
                                            @sub.Nombre
                                        </label>
                                        <span class="d-block text-muted small"><code>@sub.Codigo</code> — @sub.Creditos ECTS</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-journal-plus me-1"></i> Guardar Matriculación
                    </button>
                </form>
            }
        </div>
    </div>
</div>
