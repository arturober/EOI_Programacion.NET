@page
@model IndexModel
@{
    ViewData["Title"] = "Listado de Alumnos";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Alumnos</h1>
        <p class="page-subtitle">Listado general de alumnos registrados y sus matriculaciones</p>
    </div>
    <a asp-page="./Create" class="btn-primary-custom">
        <i class="bi bi-person-plus-fill"></i> Nuevo Alumno
    </a>
</div>

<div class="card-custom">
    @if (Model.Alumnos.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-people text-muted fs-1 mb-3 d-block"></i>
            <h5 class="fw-bold">No hay alumnos registrados</h5>
            <p class="text-muted mb-4">Comienza agregando un nuevo alumno a la base de datos.</p>
            <a asp-page="./Create" class="btn-primary-custom">
                <i class="bi bi-person-plus-fill"></i> Crear Alumno
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>DNI</th>
                        <th>Asignaturas Matriculadas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Alumnos)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.Nombre</td>
                            <td class="text-muted">@item.Email</td>
                            <td><code>@item.Dni</code></td>
                            <td>
                                <span class="badge-custom badge-primary">
                                    <i class="bi bi-journal-check me-1"></i> @item.AsignaturasCount asignaturas
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill me-1" title="Ver Detalles y Matricular">
                                    <i class="bi bi-eye-fill"></i> Detalle
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill me-1" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill" title="Eliminar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
