<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestor de Matriculaciones</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-custom">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand-title text-decoration-none" asp-page="/Index">
                <i class="bi bi-journal-bookmark-fill text-primary">
                </i> AcademyMatriculas
            </a>
            <nav class="d-flex gap-2">
                <a class="nav-link-custom @(ViewData["ActivePage"]?.ToString() == "Alumnos" ? "active" : "")" asp-page="/Alumnos/Index">
                    <i class="bi bi-people-fill me-1"></i> Alumnos
                </a>
                <a class="nav-link-custom @(ViewData["ActivePage"]?.ToString() == "Asignaturas" ? "active" : "")" asp-page="/Asignaturas/Index">
                    <i class="bi bi-book-half me-1"></i> Asignaturas
                </a>
            </nav>
        </div>
    </header>

    <main class="main-container container">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert-custom alert-success-custom" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@successMsg</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert-custom alert-danger-custom" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>@errorMsg</span>
            </div>
        }

        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p class="m-0">&copy; 2026 AcademyMatriculas — Sistema de Gestión de Alumnos y Asignaturas (.NET 10 / EF Core)</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
