@page
@model IndexModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="row align-items-center mb-5">
    <div class="col-lg-8">
        <h1 class="display-5 fw-bold mb-3">Gestión de Matriculaciones Académicas</h1>
        <p class="lead text-muted">
            Plataforma centralizada para la administración de alumnos, asignaturas y matriculación. Diseñado con ASP.NET Core (.NET 10), EF Core y C# 14.
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-custom h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge-custom badge-primary fs-6">
                        <i class="bi bi-people-fill me-1"></i> Alumnos
                    </span>
                    <span class="fs-4 fw-bold text-primary">@Model.TotalAlumnos</span>
                </div>
                <h3 class="fw-bold mb-2">Gestión de Alumnos</h3>
                <p class="text-muted mb-4">
                    Registra nuevos estudiantes, consulta sus datos y administra las asignaturas en las que se encuentran matriculados.
                </p>
            </div>
            <div>
                <a asp-page="/Alumnos/Index" class="btn-primary-custom w-100 justify-content-center">
                    Ver Alumnos <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-custom h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge-custom badge-info fs-6">
                        <i class="bi bi-book-half me-1"></i> Asignaturas
                    </span>
                    <span class="fs-4 fw-bold text-info">@Model.TotalAsignaturas</span>
                </div>
                <h3 class="fw-bold mb-2">Gestión de Asignaturas</h3>
                <p class="text-muted mb-4">
                    Administra el catálogo de asignaturas, códigos y créditos académicos, y visualiza la lista de alumnos inscritos.
                </p>
            </div>
            <div>
                <a asp-page="/Asignaturas/Index" class="btn-secondary-custom w-100 justify-content-center">
                    Ver Asignaturas <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
