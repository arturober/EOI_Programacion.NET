@page
@model CreateModel
@{
  ViewData["Title"] = "Crear Tarea";
}

<div class="container mx-auto mt-5 max-w-md">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Crear Nueva Tarea</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Input.Descripcion" class="form-control" placeholder="Aprender .NET Core 10..." />
                    <span asp-validation-for="Input.Descripcion" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Fecha" class="form-label">Fecha (Opcional)</label>
                    <input asp-for="Input.Fecha" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Input.Fecha" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Tarea</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
