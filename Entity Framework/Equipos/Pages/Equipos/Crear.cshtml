@page
@model global::Equipos.Pages.Equipos.CrearEquipoModel
@{
    ViewData["Title"] = "Crear Nuevo Equipo";
}

<form method="post">
  <div class="mb-3">
    <label asp-for="Input.Nombre" class="form-label">Nombre</label>
    <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre equipo">
    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
  </div>
  <div class="d-flex gap-4">
    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-page="/Index" class="btn btn-danger">Cancelar</a>
  </div>
</form>
